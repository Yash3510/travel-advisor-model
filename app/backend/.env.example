# Copy to backend/.env for local overrides. Real environment variables win.
# Model: any OpenAI-compatible endpoint (default: local llama-server)
MODEL_URL=http://127.0.0.1:8081
MODEL_NAME=travel-advisor-v2
MODEL_API_KEY=
MODEL_TIMEOUT_MS=60000
# Comma-separated frontend origins allowed to call the API ("*" = any, dev only)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 behind a reverse proxy so rate limiting uses X-Forwarded-For
TRUST_PROXY=0
CHAT_RATE_LIMIT_PER_MIN=20
PORT=5590
LOG_TOOLS=0
