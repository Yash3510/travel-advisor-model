# Copy to backend/.env for local overrides. Real environment variables win.
# Model: any OpenAI-compatible endpoint (default: local llama-server)
MODEL_URL=http://127.0.0.1:8081
MODEL_NAME=travel-advisor-v2
MODEL_API_KEY=
MODEL_TIMEOUT_MS=60000
# Comma-separated frontend origins allowed to call the API ("*" = any, dev only)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 behind a reverse proxy so rate limiting uses X-Forwarded-For
TRUST_PROXY=0
CHAT_RATE_LIMIT_PER_MIN=20
# Weather (Open-Meteo): the free API is non-commercial. Production needs a paid key; WEATHER=off disables it.
OPEN_METEO_API_KEY=
WEATHER=on
# Place data import (dev: public Overpass, lightly; production: self-hosted Overpass or a regional extract)
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Road times between stops: a self-hosted OSRM server (never the public demo server in production).
# Empty = straight-line estimates, labelled as estimates. docs/data-sources.md has the self-hosting steps.
ROUTING_URL=
ROUTING_TIMEOUT_MS=2000
# Destination guide pages (default: the repository's data/raw/wikivoyage)
GUIDE_DIR=
PORT=5590
LOG_TOOLS=0

# ── Accounts (D-021) ──
# The site's public address, for links in emails (verify, reset).
APP_URL=http://localhost:5173
# Email via Resend (https://resend.com). Without a key, development keeps emails in the `outbox` table; production refuses.
RESEND_API_KEY=
MAIL_FROM=Takeoff <hello@your-domain.com>
# "Continue with Google": the OAuth client id (Web application) from Google Cloud Console. Empty hides the button.
GOOGLE_CLIENT_ID=
# Secure cookies need HTTPS: on when NODE_ENV=production unless COOKIE_SECURE=0.
COOKIE_SECURE=
AUTH_SESSION_DAYS=30
# Refuse passwords seen in breaches (Have I Been Pwned range API). 0 turns it off.
PWNED_CHECK=1
# Cloudflare Turnstile secret: a bot check on sign-up, forgot-password and contact. Empty = off.
TURNSTILE_SECRET=
